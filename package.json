{
	"type": "module",
	"name": "omp-file-size-guard",
	"version": "1.2.0",
	"description": "AI-agent extension that blocks and reports oversized files, with per-project exemptions and first-run onboarding. Adapters for omp, pi, and opencode.",
	"license": "MIT",
	"homepage": "https://github.com/abdulrahmanch1/omp-file-size-guard",
	"repository": {
		"type": "git",
		"url": "https://github.com/abdulrahmanch1/omp-file-size-guard.git"
	},
	"files": [
		"core/",
		"adapters/",
		"bin/",
		"dist/",
		"README.md",
		"LICENSE"
	],
	"bin": {
		"file-size-guard": "dist/bin/fsg.js"
	},
	"omp": {
		"extensions": [
			"./adapters/omp/file-size-guard.ts"
		]
	},
	"pi": {
		"extensions": [
			"./adapters/pi/file-size-guard.ts"
		]
	},
	"devDependencies": {
		"esbuild": "^0.25.0"
	},
	"scripts": {
		"build": "node build.mjs",
		"prepublishOnly": "npm run build",
		"test": "node test/omp.test.ts && node test/pi.test.ts && node test/opencode.test.ts"
	},
	"author": "Abdulrahman (https://github.com/abdulrahmanch1)",
	"keywords": [
		"ai-agent",
		"claude-code",
		"opencode",
		"oh-my-pi",
		"pi",
		"guardrails",
		"file-size",
		"code-quality",
		"pre-commit",
		"ci"
	],
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	}
}
